POSTGRES_PASSWORD=change-this-database-password
GMV_ADMIN_USERNAME=admin
GMV_ADMIN_PASSWORD=change-this-admin-password
GMV_BIND=127.0.0.1
GMV_PORT=8080
# Set true behind an HTTPS reverse proxy.
GMV_SECURE_COOKIE=false
# Host directory mounted read-only inside containers as /imports.
GMV_IMPORT_ROOT=./data/imports
